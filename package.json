{
  "name": "forms-processor-v6",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Database-configured workflows for Topcoder form submissions",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "deploy:dev": "BRANCH=$(git rev-parse --abbrev-ref HEAD) && TAG=\"dev-${BRANCH}\" && git tag -d \"$TAG\" 2>/dev/null; git push origin \":refs/tags/$TAG\" 2>/dev/null; git tag \"$TAG\" && git push origin \"$TAG\"",
    "format": "prettier --write src test *.json *.mjs .circleci/config.yml deploy/*.yaml"
  },
  "dependencies": {
    "@platformatic/kafka": "2.8.0",
    "pg": "8.23.0",
    "zod": "4.3.6",
    "tc-core-library-js": "github:topcoder-platform/tc-core-library-js#v4.0.0-rc.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.0.0",
    "@types/pg": "8.15.6",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
