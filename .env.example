DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5546/forms?schema=forms
KAFKA_URL=localhost:9092
KAFKA_GROUP_ID=forms-processor-v6
KAFKA_SSL_ENABLED=false
# Earliest only for a new group/no valid offset; committed offsets always take precedence.
KAFKA_FROM_BEGINNING=true
# Optional until an email flow is enabled. Set all required Bus/Auth0 values together.
# BUSAPI_URL=https://api.topcoder-dev.com/v6
# AUTH0_URL=https://topcoder-dev.auth0.com/oauth/token
# AUTH0_AUDIENCE=https://www.topcoder-dev.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_PROXY_SERVER_URL=
PORT=3000

# Authoritative settings for lets-talk-sales-email; restart after changes.
# Empty values defer delivery even if stale database settings exist.
LETS_TALK_RECIPIENTS=
LETS_TALK_SENDGRID_TEMPLATE_ID=

# AI classification (docs/adr/0001). Optional; needs the Bus/Auth0 settings above.
# AI_API_URL=https://api.topcoder-dev.com/v6/ai
# AI_AUTH0_AUDIENCE=            # defaults to AUTH0_AUDIENCE
# LETS_TALK_CLASSIFY_MAX_ATTEMPTS=5
# LETS_TALK_CLASSIFY_MAX_AGE_MINUTES=30

# Label actions: one SendGrid template per flow (docs/emails/README.md). Empty ids defer their flow.
LETS_TALK_OPPORTUNITY_TEMPLATE_ID=
LETS_TALK_SKILLS_TEMPLATE_ID=
LETS_TALK_GENERAL_TEMPLATE_ID=
LETS_TALK_WIPRO_TEMPLATE_ID=
LETS_TALK_SALES_REPLY_TEMPLATE_ID=
LETS_TALK_SUPPORT_TEMPLATE_ID=
# LETS_TALK_SUPPORT_RECIPIENTS=support@topcoder.com
# First address is the sales reply's reply-to; the rest are copied.
# LETS_TALK_SALES_REPLY_TO=support@topcoder.com,test1@topcoder.com
# LETS_TALK_REPLY_CAP_PER_DAY=1
