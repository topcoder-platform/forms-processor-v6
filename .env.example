DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5546/forms?schema=forms
KAFKA_URL=localhost:9092
KAFKA_GROUP_ID=forms-processor-v6
KAFKA_SSL_ENABLED=false
# Earliest only for a new group/no valid offset; committed offsets always take precedence.
KAFKA_FROM_BEGINNING=true
