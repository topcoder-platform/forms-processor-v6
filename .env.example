DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5546/forms?schema=forms
KAFKA_URL=localhost:9092
KAFKA_GROUP_ID=forms-processor-v6
KAFKA_SSL_ENABLED=false
# Earliest only for a new group/no valid offset; committed offsets always take precedence.
KAFKA_FROM_BEGINNING=true
# Optional until email delivery is enabled; configure all Bus/Keycloak values together.
# BUSAPI_URL=https://api.topcoder-dev.com/v6
# M2M_PROVIDER=keycloak
# KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
# KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
# KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_SCOPE=write:bus_api
PORT=3000

# Authoritative settings for lets-talk-sales-email; restart after changes.
# Empty values defer delivery even if stale database settings exist.
LETS_TALK_RECIPIENTS=
LETS_TALK_SENDGRID_TEMPLATE_ID=
